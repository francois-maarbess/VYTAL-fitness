# ── API Server ──────────────────────────────────────────────
PORT=10000

# ── Clerk Auth ──────────────────────────────────────────────
# Production keys from https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=pk_live_xxxxx
CLERK_SECRET_KEY=sk_live_xxxxx

# Webhook secret from Clerk Dashboard → Webhooks → Signing Secret
CLERK_WEBHOOK_SECRET=whsec_xxxxx

# ── AI (Groq) ──────────────────────────────────────────────
# https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxx

# ── Database (Supabase) ────────────────────────────────────
# Pooler URL (port 6543) — for runtime queries
DATABASE_URL=postgresql://postgres.EXAMPLE:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct URL (port 5432) — for migrations and seed
DIRECT_URL=postgresql://postgres.EXAMPLE:password@aws-0-region.pooler.supabase.com:5432/postgres

# ── Nutrition (USDA) ────────────────────────────────────────
# DEMO_KEY works for dev (1,000 req/day). Get a real key at https://fdc.nal.usda.gov/api-guide
USDA_API_KEY=DEMO_KEY

# ── Frontend (Expo) ────────────────────────────────────────
# These are baked into the web/native bundle at build time
EXPO_PUBLIC_API_URL=https://vytal-api-3y1t.onrender.com
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxx
