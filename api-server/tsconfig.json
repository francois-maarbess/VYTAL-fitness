{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@workspace/db": ["../lib/db/src/index.ts"]
    },
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "../lib/db/src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
